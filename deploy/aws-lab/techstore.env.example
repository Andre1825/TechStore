# Plantilla para /etc/techstore/techstore.env. Sustituye los valores de ejemplo.
# Guarda el archivo real solo en EC2, propietario root, permisos 600.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_URL="jdbc:postgresql://RDS_ENDPOINT:5432/techstore_db?sslmode=verify-full&sslrootcert=/etc/techstore/us-east-1-bundle.pem"
DB_USERNAME=techstore_owner
DB_PASSWORD="REEMPLAZAR_PASSWORD_RDS"
ADMIN_PASSWORD="REEMPLAZAR_PASSWORD_ADMIN_MINIMO_12_CARACTERES"
AWS_REGION=us-east-1
SNS_ENABLED=true
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:techstore-stock-bajo
